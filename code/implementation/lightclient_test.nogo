package lightclientsignature

import (
	"crypto/rand"
	"math"
	"math/big"
	"reflect"
	"testing"
)

type testProver struct {
	genesisKeys []PublicKey
	committees  [][]PublicKey
	breaks      []big.Int
	signatures  [][][]byte
	quorum      int
}

func newTestProver(committee, quorum, length, periodLength int) *testProver {
	// Create fake committee chain where changes are infrequent and where
	// a fixed quorum always remains
	genesis := make([]PublicKey, committee)
	signingKeys := make([]*PrivateKey, committee)
	for i := 0; i < committee; i++ {
		privKey, _ := GenerateKey(rand.Reader)
		genesis[i] = privKey.PublicKey
		signingKeys[i] = privKey
	}

	committees := make([][]PublicKey, length)
	breaks := make([]big.Int, length/periodLength)
	sigs := make([][][]byte, length)
	prev := genesis
	for i := 0; i < length; i++ {
		next := make([]PublicKey, committee)
		breakPoint := (i%periodLength == 0)
		if !breakPoint {
			copy(next, prev)
		} else {
			breaks = append(breaks, *big.NewInt(int64(i + 1)))
			// Change all committee members except for a core quorum
			copy(next[:quorum], genesis[:quorum])
			for j := quorum; j < committee; j++ {
				privKey, _ := GenerateKey(rand.Reader)
				next[j] = privKey.PublicKey
			}
		}
		committees[i] = next

		// The static quorum signs the new list of keys
		quorumSigs := make([][]byte, quorum)
		s := make([]byte, sizeSignature)
		for j := 0; j < quorum; j++ {
			if breakPoint {
				s, _ = signingKeys[j].SignBreak(big.NewInt(int64(i+1)), next)
			} else {
				s, _ = signingKeys[j].SignNoBreak(big.NewInt(int64(i + 1)))
			}
			quorumSigs[j] = s
		}
		sigs[i] = quorumSigs
		prev = next
	}

	return &testProver{
		quorum:      quorum,
		genesisKeys: genesis,
		committees:  committees,
		signatures:  sigs,
		breaks:      breaks,
	}
}

func (p *testProver) Update(epoch *big.Int) (LightClientProof, error) {
	breaks := []big.Int{}
	for i, b := range p.breaks {
		if b.Cmp(epoch) >= 0 {
			breaks = p.breaks[i:]
			break
		}
	}
	lastBreakIsActualBreak := true
	newLastBreak := big.NewInt(int64(len(p.committees)))
	if newLastBreak.Cmp(&breaks[len(breaks)-1]) != 0 {
		breaks = append(breaks, *newLastBreak)
		lastBreakIsActualBreak = false
	}

	bitMaps := [][]byte{}
	newKeys := [][]PublicKey{}
	toAggregate := [][]byte{}
	var prev big.Int
	prev.Set(epoch)
	for i, b := range breaks {
		// collect the core quorum's signatures from prev to b
		for j := int(prev.Int64()); j <= int(b.Int64()); j++ {
			toAggregate = append(toAggregate, p.signatures[j-1][:p.quorum]...)
		}

		// encode the fixed quorum as a bit vector
		numberBytes := int(math.Ceil(float64(len(p.committees[0])) / 8))
		bits := make([]byte, numberBytes)
		for j := range bits {
			b := 0
			for k := 0; (k < 8) && (8*j+k < len(p.committees[0])); k++ {
				if 8*j+k < p.quorum {
					b = b + 1<<k
				}
			}
			bits[j] = byte(b)
		}
		bitMaps = append(bitMaps, bits)

		if (i == len(breaks)-1) && !lastBreakIsActualBreak {
			break
		}
		newKeys = append(newKeys, p.committees[int(b.Int64())-1])

		prev.Add(&b, one)
	}

	signature := AggregateSignatures(toAggregate)

	return LightClientProof{
		NewKeys:   newKeys,
		BitMaps:   bitMaps,
		Signature: signature,
		Breaks:    breaks,
	}, nil
}

func TestUpdate(t *testing.T) {
	committee := 10
	quorum := 7
	length := 20
	periodLength := length / 5
	prover := newTestProver(committee, quorum, length, periodLength)
	genesisKeys := make([]PublicKey, committee)
	copy(genesisKeys, prover.genesisKeys)

	lc := NewLightClient(genesisKeys, quorum)

	err := lc.Update(prover)
	if err != nil {
		t.Fatal(err)
	}
	if lc.Epoch.Cmp(big.NewInt(int64(length+1))) != 0 {
		t.Fatalf("wrong final epoch: want %v; got %v", length+1, lc.Epoch.Int64())
	}
	if reflect.DeepEqual(lc.Keys, prover.committees[length-1]) == false {
		t.Fatal("wrong final keys")
	}
}
